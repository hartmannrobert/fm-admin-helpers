{
  "manifest_version": 3,
  "name": "Fusion Manage Helper",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FM",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "options_ui": {
    "page": "options/options.html"
  },
  "host_permissions": [
    "https://*.autodeskplm360.net/plm/*",
    "https://*.autodeskplm360.net/admin*",
    "https://*.autodeskplm360.net/script.form*",
    "https://*.autodesk360.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/default-snippets.json", "data/field-defaults.json"],
      "matches": ["https://*.autodeskplm360.net/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.autodeskplm360.net/script.form*",
        "https://*.autodeskplm360.net/plm/admin/system-configuration/scripting*",
        "https://*.autodeskplm360.net/plm/*"
      ],
      "js": ["content/ace-capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.autodeskplm360.net/plm/admin/workspace-manager*"
      ],
      "js": ["content/workspace-grid-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.autodeskplm360.net/plm/*",
        "https://*.autodeskplm360.net/admin*",
        "https://*.autodeskplm360.net/script.form*"
      ],
      "js": [
        "content/config-bridge.js",
        "content/utils.js",
        "content/snippet-storage.js",
        "content/go-to-function.js",
        "content/snippet-modal.js",
        "content/feature-buttons.js",
        "content/feature-admin-titles.js",
        "content/feature-fieldid.js",
        "content/feature-scripts.js",
        "content/feature-security.js",
        "content/feature-workspace.js",
        "content/feature-bom-views.js",
        "content/feature-field-defaults.js",
        "content/feature-revision-sort.js",
        "content/bootstrap.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.autodesk360.com/*"
      ],
      "js": [
        "content/config-bridge.js",
        "content/utils.js",
        "content/feature-buttons.js",
        "content/feature-workspace-access.js",
        "content/bootstrap.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
